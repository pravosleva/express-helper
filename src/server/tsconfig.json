{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "downlevelIteration": true,
    "target": "ES5",
    "removeComments": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "module": "commonjs",
    "outDir": "../../server-dist",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "./*"
      ],
      "@getRandomInteger": [
        "./utils/getRandomInteger"
      ]
    },
    "sourceMap": false,
    "esModuleInterop": true,
  },
  "include": [
    "**/*.ts",
    "**/*.js"
  ],
  "exclude": [
    "tsconfig.json",
    "**/tsconfig.json",
    "**/routers/chat/@socket.io/admin-ui-*/**/*.ts"
  ]
}